rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada documento pertence a um único usuário (campo usuarioId).
    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.usuarioId;
    }
    function isOwnerForCreate() {
      return request.auth != null && request.auth.uid == request.resource.data.usuarioId;
    }

    // Perfil do usuário: só o próprio dono acessa.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /clientes/{id} {
      allow read: if isOwner();
      allow create: if isOwnerForCreate();
      allow update: if isOwner() && isOwnerForCreate();
      allow delete: if isOwner();
    }

    match /agendamentos/{id} {
      allow read: if isOwner();
      allow create: if isOwnerForCreate();
      allow update: if isOwner() && isOwnerForCreate();
      allow delete: if isOwner();
    }

    match /tarefas/{id} {
      allow read: if isOwner();
      allow create: if isOwnerForCreate();
      allow update: if isOwner() && isOwnerForCreate();
      allow delete: if isOwner();
    }

    match /transacoes/{id} {
      allow read: if isOwner();
      allow create: if isOwnerForCreate();
      allow update: if isOwner() && isOwnerForCreate();
      allow delete: if isOwner();
    }

    match /notas/{id} {
      allow read: if isOwner();
      allow create: if isOwnerForCreate();
      allow update: if isOwner() && isOwnerForCreate();
      allow delete: if isOwner();
    }

    match /arquivos/{id} {
      allow read: if isOwner();
      allow create: if isOwnerForCreate();
      allow update: if isOwner() && isOwnerForCreate();
      allow delete: if isOwner();
    }
  }
}
